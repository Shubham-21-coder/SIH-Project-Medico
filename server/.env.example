# ============================================================
# MEDIKIOSK REAL SMS OTP AUTHENTICATION CONFIGURATION
# ============================================================
# Configure at least ONE of the SMS providers below to send real OTPs.
# The server will automatically detect and route through the configured gateway.

# ------------------------------------------------------------
# Option 1: Twilio Verify Service (Recommended for Global/India)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Option 2: Twilio Programmable SMS Gateway
# ------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ------------------------------------------------------------
# Option 3: 2Factor.in (Direct Indian Telecom Route)
# ------------------------------------------------------------
# TWOFACTOR_API_KEY=your_2factor_api_key_here

# ------------------------------------------------------------
# Option 4: Fast2SMS (Indian Bulk V2 Route)
# ------------------------------------------------------------
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------
# Server Security & Gemini AI Keys
# ------------------------------------------------------------
PORT=3001
OTP_SALT=your_custom_secure_salt_string_here
GEMINI_API_KEY=your_gemini_api_key_here
